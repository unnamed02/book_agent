# ============================================
# AI 图书推荐助手 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================

# --------------------------------------------
# LLM API 配置（必填）
# --------------------------------------------

# OpenAI 兼容 API 配置
# 使用阿里云 DashScope（通义千问）
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 阿里云 DashScope API Key（用于联网搜索功能，必填）
DASHSCOPE_API_KEY=your_dashscope_key_here

# --------------------------------------------
# 数据库配置（根据环境选择）
# --------------------------------------------

# 方案 A: PostgreSQL（生产环境推荐）
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/book_agent

# 方案 B: SQLite（开发/测试环境，无需额外安装）
DATABASE_URL=sqlite+aiosqlite:///./book_agent.db

# --------------------------------------------
# Redis 配置（必填）
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# 第三方服务 API（可选）
# --------------------------------------------

# 豆瓣 API Key（用于图书信息查询）
DOUBAN_API_KEY=your_douban_api_key

# Tavily 搜索 API（用于增强搜索功能）
TAVILY_API_KEY=your_tavily_key

# --------------------------------------------
# 系统配置
# --------------------------------------------

# 调试模式（生产环境设为 false）
DEBUG_MODE=false

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# --------------------------------------------
# CORS 配置（生产环境必须修改）
# --------------------------------------------
# 开发环境允许所有域名
ALLOWED_ORIGINS=*

# 生产环境示例：只允许小程序域名
# ALLOWED_ORIGINS=https://your-domain.com,https://mp.weixin.qq.com
