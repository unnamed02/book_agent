<!--components/book-card/book-card.wxml-->
<view class="book-cards-container">
  <swiper
    class="book-swiper"
    indicator-dots="{{safeBooks.length > 1}}"
    indicator-color="rgba(0, 0, 0, .3)"
    indicator-active-color="#1890ff"
    circular="{{false}}"
    autoplay="{{false}}"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{safeBooks}}" wx:key="index">
      <scroll-view class="book-card" scroll-y="{{true}}">
        <!-- 书籍封面 -->
        <image
          wx:if="{{item.image}}"
          class="book-cover"
          src="{{item.image}}"
          mode="aspectFit"
        />

        <!-- 书籍信息 -->
        <view class="book-info">
          <view class="book-title">{{item.title}}</view>
          <view class="book-author">{{item.author}}</view>
          <view class="book-meta">
            <text wx:if="{{item.publisher && item.publisher !== '未知'}}" class="book-publisher">{{item.publisher}}</text>
            <text wx:if="{{item.rating}}" class="book-rating">⭐ {{item.rating}}</text>
          </view>

          <!-- 推荐理由 -->
          <view wx:if="{{item.reason}}" class="book-reason">
            <text class="reason-label">推荐理由：</text>
            <text class="reason-text">{{item.reason}}</text>
          </view>

          <!-- 馆藏信息 -->
          <view wx:if="{{item.hasLibrary}}" class="book-section">
            <view class="section-title">现售书籍</view>
            <view class="library-list">
              <view
                wx:for="{{item.libraryItems}}"
                wx:for-item="lib"
                wx:key="index"
                class="library-item"
              >
                <view wx:if="{{lib.title}}" class="library-title">{{lib.title}}</view>
                <view wx:if="{{item.author}}" class="library-pub-info">作者: {{item.author}}</view>
                <view wx:if="{{lib.pub_info}}" class="library-pub-info">{{lib.pub_info}}</view>
                <view class="library-detail" style="display: flex; justify-content: space-between; align-items: center;">
                  <text>位置: {{lib.location}} | 架号: {{lib.shelf_number}}</text>
                  <view style="display: flex; align-items: center; gap: 8rpx;">
                    <text style="color: #f5222d; font-weight: 500;">¥{{lib.discount_price || lib.price}}</text>
                    <text wx:if="{{lib.discount && lib.discount_price}}" style="color: #999; font-size: 20rpx; text-decoration: line-through;">¥{{lib.price}}</text>
                  </view>
                </view>
                <view class="library-detail">状态: {{lib.stock > 0 ? '有货' : '缺货'}} (库存{{lib.stock}}本)</view>
              </view>
            </view>
          </view>

          <!-- 网店在售 -->
          <view wx:if="{{item.hasOnlineStores}}" class="book-section">
            <view class="section-title">网店在售</view>
            <view class="library-list">
              <view
                wx:for="{{item.onlineStores}}"
                wx:for-item="store"
                wx:key="index"
                class="library-item"
              >
                <view wx:if="{{store.title}}" class="library-title">{{store.title}}</view>
                <view wx:if="{{item.author}}" class="library-pub-info">作者: {{item.author}}</view>
                <view wx:if="{{store.pub_info}}" class="library-pub-info">{{store.pub_info}}</view>
                <view class="library-detail" style="display: flex; justify-content: space-between; align-items: center;">
                  <text style="color: #1677ff; font-size: 24rpx;">{{store.source}}</text>
                  <view style="display: flex; align-items: center; gap: 8rpx;">
                    <text style="color: #f5222d; font-weight: 500;">¥{{store.discount_price || store.price}}</text>
                    <text wx:if="{{store.discount && store.discount_price}}" style="color: #999; font-size: 20rpx; text-decoration: line-through;">¥{{store.price}}</text>
                  </view>
                </view>
                <view style="display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx;">
                  <view 
                    class="store-link"
                    bindtap="onStoreLinkTap"
                    data-url="{{store.link}}"
                  >
                    查看详情 &gt;
                  </view>
                  <button 
                    class="store-btn"
                    size="mini"
                    type="primary"
                    bindtap="onStoreLinkTap"
                    data-url="{{store.link}}"
                  >
                    下单
                  </button>
                </view>
              </view>
            </view>
          </view>

          <!-- 读者订购按钮（所有书籍都显示） -->
          <view class="book-section">
            <view class="section-title">读者订购</view>
            <view class="library-list">
              <view class="library-item recommend-item">
                <view class="recommend-info">
                  <text class="recommend-desc">如需订购本书，可提交订购申请</text>
                </view>
                <text
                  class="recommend-link"
                  bindtap="onRecommendTap"
                  data-title="{{item.title}}"
                  data-author="{{item.author}}"
                >
                  订购
                </text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <!-- 页码指示器 -->
  <view wx:if="{{safeBooks.length > 1}}" class="page-indicator">
    {{currentPage + 1}} / {{safeBooks.length}}
  </view>
</view>
